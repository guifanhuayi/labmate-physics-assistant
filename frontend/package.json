{
  "name": "labmate-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:univer": "playwright test --config playwright.univer.config.ts",
    "e2e:student": "playwright test --config playwright.student.config.ts",
    "e2e:admin": "playwright test --config playwright.admin.config.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "1.24.0",
    "@ant-design/pro-components": "2.8.10",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@univerjs/core": "1.2.0",
    "@univerjs/design": "1.2.0",
    "@univerjs/docs": "1.2.0",
    "@univerjs/docs-ui": "1.2.0",
    "@univerjs/engine-render": "1.2.0",
    "@univerjs/sheets": "1.2.0",
    "@univerjs/sheets-ui": "1.2.0",
    "@univerjs/ui": "1.2.0",
    "antd": "5.29.3",
    "pinia": "^3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
